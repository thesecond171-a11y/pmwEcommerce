# ==========================================
# PMW POLSRI STORE - ENVIRONMENT VARIABLES
# ==========================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Midtrans Configuration (Payment Gateway)
# Dapatkan di: https://dashboard.midtrans.com/ (Mode Sandbox)
MIDTRANS_SERVER_KEY=SB-Mid-server-your-sandbox-server-key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-your-sandbox-client-key
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
